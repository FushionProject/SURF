# Server-only provider keys. Never prefix these with NEXT_PUBLIC_.
ODDS_API_KEY=
API_SPORTS_KEY=

# Durable server-only line history. Never use NEXT_PUBLIC_ for the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Browser-safe Supabase Auth configuration. The publishable key is designed to
# be public; never put a secret or service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe is opt-in. Use an existing Surf recurring Price; no price is invented.
# Keep keys server-only in the host's secrets store (or private .env.local).
# Prefer a restricted key with the least permissions documented in docs/billing.md.
SURF_BILLING_ENABLED=false
SURF_BILLING_LIVE_ENABLED=false
SURF_SPOT_STATS_RELEASE_READY=false

# Publishes the Spot Stats feed at /stats from the stored nflverse archive.
# Off unless set to true. Attribution is rendered on the page; publication
# rights for the upstream data remain unconfirmed and this does not change that.
SURF_SPOT_STATS_PUBLISHED=false
STRIPE_RESTRICTED_KEY=
STRIPE_SIGNALS_PRICE_ID=
STRIPE_SIGNALS_SPOT_STATS_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Prediction-market providers are opt-in per source. Each must be named
# explicitly, so an uncleared provider is never collected or displayed.
# SURF_PREDICTION_MARKETS_ENABLED=false is a master kill switch that overrides
# both gates. The default whale cash threshold is $10,000.
SURF_PREDICTION_MARKETS_ENABLED=true
SURF_KALSHI_ENABLED=false
SURF_POLYMARKET_ENABLED=false
SURF_PREDICTION_WHALE_THRESHOLD_USD=10000

# Comp access for the owner and invited reviewers. Comma-separated confirmed
# account emails get Signals and Spot Stats without Stripe and without any
# charge. Unset or empty grants nobody; this never enables billing.
SURF_COMP_ACCESS_EMAILS=
