# Server-only provider keys. Never prefix these with NEXT_PUBLIC_.
ODDS_API_KEY=
API_SPORTS_KEY=

# Durable server-only line history. Never use NEXT_PUBLIC_ for the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Public prediction-market data is enabled by default. Set this to false for a
# complete kill switch; the default whale cash threshold is $10,000.
SURF_PREDICTION_MARKETS_ENABLED=true
SURF_PREDICTION_WHALE_THRESHOLD_USD=10000
